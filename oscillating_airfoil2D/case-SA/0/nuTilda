FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nuTilda;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0]; 

internalField uniform     1.42e-4;

boundaryField
{
  far
  {
        type            freestream;
        freestreamValue $internalField;
        freestreamBC    fixedValue;
  }
  background_ymin
  {
        type            empty;
  }
  background_ymin
  {
        type            empty;
  }
  airfoil_surface
  {
        type            fixedValue;
        value           uniform 0;
  }
  #include        "include/cyclicAMI"
}
