FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;  
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0]; 

#include        "include/freestreamConditions"
internalField   uniform $p; 

boundaryField
{
  far
    {
        type            freestreamPressure;
        freestreamValue $internalField;
    }

  background_ymin
  {   
        type            empty;
  }
  airfoilzone_ymin
  {   
        type            empty;
  }
  airfoil_surface
  {   
        type       zeroGradient;
  }   
  #include        "include/cyclicAMI"
}
